        <key name="xhtheme_ai_toolbox_settings">
            <!-- AI Summary Settings -->
            <key name="summaryTitle" />
            <key name="summaryDesc" />
            <!-- AI Thread Settings -->
            <key name="primaryThreadTitle" />
            <key name="primaryThreadDesc" />
        </key>
    </admin-texts>

    <!-- Post Custom Fields -->
    <custom-fields>
        <!-- AI Excerpt / AI 摘要 -->
        <custom-field action="translate">_xhai_excerpt</custom-field>
