    <!-- Term/Taxonomy Custom Fields -->
    <custom-term-fields>
        <!-- Tag/Term SEO Title / 标签SEO标题 -->
        <custom-term-field action="translate">_seotitle</custom-term-field>
    </custom-term-fields>
</wpml-config>
